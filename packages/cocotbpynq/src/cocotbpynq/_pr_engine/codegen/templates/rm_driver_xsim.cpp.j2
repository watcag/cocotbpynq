// RM driver for {{ variant_name }} (partition {{ part.name }}) on the Vivado simulator (XSI)
// Generated by partial_reconfiguration
//
// Same protocol as rm_driver.cpp (three barriers per cycle), but the RM wrapper
// runs as an xsim snapshot built with `xelab -dll`.  The wrapper's DPI functions
// live in libdpi_rm.so, which xsim loads; this driver loads it first with
// RTLD_GLOBAL and sets its channel pointer, so both use the same copy.
// Each half clock period is 2.5 ns of xsim time (UNISIM models delay some outputs by 100 ps,
// so the period must be realistic; idle time costs nothing); the snapshot first runs
// past glbl's 100 ns GSR pulse, so a Vivado netlist starts from its INIT values.

#include "dpi_shm_channel.h"
#include "barrier_sync.h"
#include "xsi_loader.h"

#include <cstring>
#include <cstdlib>
#include <iostream>
#include <string>
#include <dlfcn.h>
#include <sys/mman.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <unistd.h>

static void* mmap_file(const char* path, size_t expected_size, int* fd_out) {
    int fd = open(path, O_RDWR);
    if (fd < 0) { perror(path); return nullptr; }
    struct stat st;
    fstat(fd, &st);
    size_t sz = (expected_size > 0) ? expected_size : (size_t)st.st_size;
    void* ptr = mmap(nullptr, sz, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
    if (ptr == MAP_FAILED) { perror("mmap"); close(fd); return nullptr; }
    if (fd_out) *fd_out = fd; else close(fd);
    return ptr;
}

int main(int argc, char** argv) {
    const char* shm_dir = nullptr;
    int partition_index = -1;
    for (int i = 1; i < argc; i++) {
        if (std::string(argv[i]) == "--shm-dir" && i + 1 < argc)
            shm_dir = argv[++i];
        else if (std::string(argv[i]) == "--partition-index" && i + 1 < argc)
            partition_index = std::stoi(argv[++i]);
    }
    if (!shm_dir || partition_index < 0) {
        std::cerr << "Usage: rm_binary --shm-dir DIR --partition-index N" << std::endl;
        return 1;
    }
    std::string dir(shm_dir);
    std::string here = "{{ rm_dir }}";

    int ch_fd = -1;
    std::string ch_path = dir + "/partition_" + std::to_string(partition_index) + ".shm";
    void* base = mmap_file(ch_path.c_str(), 0, &ch_fd);
    if (!base) return 1;
    struct stat ch_st; fstat(ch_fd, &ch_st);

    int br_fd = -1;
    ShmBarrier* barrier = (ShmBarrier*)mmap_file((dir + "/barrier.shm").c_str(), 4096, &br_fd);
    if (!barrier) return 1;

    // The DPI library, shared with the snapshot (same path, so dlopen returns this copy).
    void* dpi = dlopen((here + "/libdpi_rm.so").c_str(), RTLD_NOW | RTLD_GLOBAL);
    if (!dpi) { std::cerr << dlerror() << std::endl; return 1; }
    *(void**)dlsym(dpi, "g_channel_base") = base;
    *(ShmPartitionHeader**)dlsym(dpi, "g_channel_header") = shm_header(base);
    ShmPartitionHeader* header = shm_header(base);

    if (chdir(here.c_str()) != 0) { perror(here.c_str()); return 1; }
    Xsi::Loader xsi("xsim.dir/rm/xsimk.so", XSI_KERNEL);   // libxv_simulator_kernel.so from 2024.1, librdi_simulator_kernel.so before
    s_xsi_setup_info info;
    memset(&info, 0, sizeof(info));
    char log_name[] = "xsim_rm.log";
    info.logFileName = log_name;
    xsi.open(&info);

    const s_xsi_vlog_logicval one = {1, 0}, zero = {0, 0};
{% for clk in part.clock_names %}
    int port_{{ clk }} = xsi.get_port_number("{{ clk }}");
    if (port_{{ clk }} < 0) { std::cerr << "no port {{ clk }}" << std::endl; return 1; }
{% endfor %}
    auto clock = [&](const s_xsi_vlog_logicval& v) {
{% for clk in part.clock_names %}
        xsi.put_value(port_{{ clk }}, &v);
{% endfor %}
        xsi.run(2500);   // ps
    };

    clock(zero);
    xsi.run(110000);   // past glbl.GSR (100 ns)
{% if part.reset_name is not none and part.reset_behavior != 'none_intel' %}
    int port_rst = xsi.get_port_number("{{ part.reset_name }}");
    const s_xsi_vlog_logicval rst_on = {{ '{' }}{{ assert_val }}, 0{{ '}' }}, rst_off = {{ '{' }}{{ deassert_val }}, 0{{ '}' }};
    xsi.put_value(port_rst, &rst_on);
    for (int c = 0; c < {{ part.reset_cycles }}; c++) { clock(zero); clock(one); }
    xsi.put_value(port_rst, &rst_off);
{% endif %}

    uint32_t local_sense = __atomic_load_n(&barrier->sense, __ATOMIC_ACQUIRE);
    shm_store32(&header->rm_ready, 1);

    while (true) {
        if (shm_load32(&header->quit)) {
            shm_store32(&header->rm_ready, 0);
            break;
        }
        clock(zero);
        barrier_wait(barrier, &local_sense);  // 1: negedge done
        barrier_wait(barrier, &local_sense);  // 2: swap done
        clock(one);
        barrier_wait(barrier, &local_sense);  // 3: posedge done
    }

    xsi.close();
    munmap(base, ch_st.st_size); close(ch_fd);
    munmap(barrier, 4096); close(br_fd);
    return 0;
}
