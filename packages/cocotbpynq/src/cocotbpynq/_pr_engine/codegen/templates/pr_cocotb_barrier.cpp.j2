// Cocotb barrier DPI library — generated by partial_reconfiguration
// No main() — cocotb provides main via verilator.cpp

#include "dpi_shm_channel.h"
#include "barrier_sync.h"
#include "shm_mailbox.h"

#include <cstdint>
#include <cstring>
#include <cstdlib>
#include <iostream>
#include <sys/mman.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <unistd.h>
#include <sched.h>

#define NUM_PARTITIONS {{ num_partitions }}

// Exported for dpi_static_*.cpp
void* g_partition_bases[NUM_PARTITIONS];

// Partition port accessors (no static model dependency)
{% for part in partitions %}
static inline uint64_t read_{{ part.name }}_port(int port_idx) {
    void* base = g_partition_bases[{{ part.index }}];
    ShmPartitionHeader* hdr = shm_header(base);
    switch (port_idx) {
{% set ns = namespace(slot=0) %}
{% for port in part.to_rm_ports %}
{% set nc = num_chunks(port.width|default(32)) %}
{% for c in range(nc) %}
        case {{ ns.slot }}: {
            ShmPortOverride* ovr = shm_to_rm_override(base, {{ ns.slot }});
            if (shm_load32(&ovr->active)) return shm_load64_relaxed(&ovr->value);
            return shm_load64_relaxed(&shm_to_rm_inbox(base, {{ ns.slot }})->data);
        }
{% set ns.slot = ns.slot + 1 %}
{% endfor %}
{% endfor %}
{% set ns2 = namespace(from_slot=0) %}
{% for port in part.from_rm_ports %}
{% set nc = num_chunks(port.width|default(32)) %}
{% for c in range(nc) %}
        case {{ ns.slot }}: return shm_load64_relaxed(&shm_from_rm_outbox(base, hdr->num_to_rm, {{ ns2.from_slot }})->data);
{% set ns.slot = ns.slot + 1 %}
{% set ns2.from_slot = ns2.from_slot + 1 %}
{% endfor %}
{% endfor %}
        default: return 0;
    }
}

static inline void write_{{ part.name }}_port(int port_idx, uint64_t value) {
    void* base = g_partition_bases[{{ part.index }}];
    switch (port_idx) {
{% set ns3 = namespace(slot=0) %}
{% for port in part.to_rm_ports %}
{% set nc = num_chunks(port.width|default(32)) %}
{% for c in range(nc) %}
        case {{ ns3.slot }}: {
            ShmPortOverride* ovr = shm_to_rm_override(base, {{ ns3.slot }});
            shm_store64_relaxed(&ovr->value, value);
            shm_store32(&ovr->active, 1);
            break;
        }
{% set ns3.slot = ns3.slot + 1 %}
{% endfor %}
{% endfor %}
        default: break;
    }
}

{% endfor %}
static ShmPartitionHeader* g_partition_headers[NUM_PARTITIONS];
static size_t g_partition_sizes[NUM_PARTITIONS];

static ShmMailbox* g_mailbox = nullptr;
static ShmBarrier* g_barrier = nullptr;
static uint32_t g_local_sense = 0;
static bool g_first_cycle = true;
static bool g_quit = false;
static int g_reconfig_partition = -1;

static void* mmap_file(const char* path, size_t expected_size) {
    int fd = open(path, O_RDWR);
    if (fd < 0) { perror(path); return nullptr; }
    struct stat st;
    fstat(fd, &st);
    size_t sz = (expected_size > 0) ? expected_size : (size_t)st.st_size;
    void* ptr = mmap(nullptr, sz, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
    if (ptr == MAP_FAILED) { perror("mmap"); close(fd); return nullptr; }
    // Keep fd open (mmap stays valid)
    return ptr;
}

static void swap_channels() {
    for (int p = 0; p < NUM_PARTITIONS; p++) {
        void* base = g_partition_bases[p];
        ShmPartitionHeader* hdr = g_partition_headers[p];
        if (shm_load32(&hdr->quit)) continue;  // skip partitions being reconfigured
        uint32_t T = hdr->num_to_rm;
        uint32_t F = hdr->num_from_rm;
        for (uint32_t i = 0; i < T; i++) {
            ShmPort* ob = shm_to_rm_outbox(base, i);
            ShmPort* ib = shm_to_rm_inbox(base, i);
            ib->data = ob->data;
            ib->valid = ob->valid;
            ob->valid = 0;
        }
        for (uint32_t i = 0; i < F; i++) {
            ShmPort* ob = shm_from_rm_outbox(base, T, i);
            ShmPort* ib = shm_from_rm_inbox(base, T, i);
            ib->data = ob->data;
            ib->valid = ob->valid;
            ob->valid = 0;
        }
    }
}

static void process_commands() {
    if (g_mailbox->cmd == CMD_NOOP) return;

    switch (g_mailbox->cmd) {
    case CMD_READ: {
        uint64_t val = 0;
        if (g_mailbox->target == TARGET_STATIC) {
            // Static port reads not supported via mailbox in cocotb mode.
            // Use cocotb VPI to read static region ports directly.
            val = 0;
        }
{% for part in partitions %}
        else if (g_mailbox->target == {{ part.index + 1 }}) {
            val = read_{{ part.name }}_port(g_mailbox->port_idx);
        }
{% endfor %}
        g_mailbox->read_value = val;
        g_mailbox->cmd = CMD_NOOP;
        break;
    }
    case CMD_WRITE: {
        if (g_mailbox->target == TARGET_STATIC) {
            // Static port writes not supported via mailbox in cocotb mode.
        }
{% for part in partitions %}
        else if (g_mailbox->target == {{ part.index + 1 }}) {
            write_{{ part.name }}_port(g_mailbox->port_idx, g_mailbox->write_value);
        }
{% endfor %}
        g_mailbox->cmd = CMD_NOOP;
        break;
    }
    case CMD_RECONFIG: {
        int part_id = g_mailbox->target - 1;
        if (part_id >= 0 && part_id < NUM_PARTITIONS) {
            // Set quit flag — RM will exit after current cycle
            shm_store32(&g_partition_headers[part_id]->quit, 1);
            // Clear overrides
            void* base = g_partition_bases[part_id];
            for (uint32_t i = 0; i < g_partition_headers[part_id]->num_to_rm; i++) {
                ShmPortOverride* ovr = shm_to_rm_override(base, i);
                shm_store32(&ovr->active, 0);
            }
            g_reconfig_partition = part_id;
        }
        // Don't set cmd=NOOP yet — Python waits until reconfig completes
        break;
    }
    case CMD_BATCH: {
        uint32_t n = g_mailbox->batch_count;
        if (n > MAX_BATCH) n = MAX_BATCH;
        for (uint32_t b = 0; b < n; b++) {
            ShmBatchSlot* slot = &g_mailbox->batch[b];
            switch (slot->cmd) {
            case CMD_READ: {
                uint64_t val = 0;
                if (slot->target == TARGET_STATIC) { val = 0; }
{% for part in partitions %}
                else if (slot->target == {{ part.index + 1 }}) {
                    val = read_{{ part.name }}_port(slot->port_idx);
                }
{% endfor %}
                slot->read_value = val;
                break;
            }
            case CMD_WRITE: {
                if (slot->target == TARGET_STATIC) { /* noop in cocotb mode */ }
{% for part in partitions %}
                else if (slot->target == {{ part.index + 1 }}) {
                    write_{{ part.name }}_port(slot->port_idx, slot->write_value);
                }
{% endfor %}
                break;
            }
            }
        }
        g_mailbox->cmd = CMD_NOOP;
        break;
    }
    case CMD_QUIT:
        g_quit = true;
        g_mailbox->cmd = CMD_NOOP;
        break;
    }
}

extern "C" {

void pr_cocotb_negedge_barrier() {
    if (!g_mailbox || !g_barrier) return;  // SHM init failed
    if (g_quit) return;

    if (!g_first_cycle) {
        // B3: posedge done (previous cycle's posedge just completed)
        barrier_wait(g_barrier, &g_local_sense);

        // Handle pending reconfiguration after B3
        if (g_reconfig_partition >= 0) {
            ShmPartitionHeader* hdr = g_partition_headers[g_reconfig_partition];
            // Phase 1: wait for old RM to clear rm_ready (it clears on quit) or parent to clear it
            while (shm_load32(&hdr->rm_ready)) { sched_yield(); }
            // Phase 2: wait for new RM to set rm_ready (started by parent after old RM exits)
            while (!shm_load32(&hdr->rm_ready)) { sched_yield(); }
            shm_store32(&hdr->quit, 0);
            shm_store32(&hdr->rm_ready, 0);
            g_reconfig_partition = -1;
            g_mailbox->cmd = CMD_NOOP;  // Signal completion to Python
        }
    }
    g_first_cycle = false;

    // B1: negedge done
    barrier_wait(g_barrier, &g_local_sense);

    // B2: swap channels + process commands
    swap_channels();
    process_commands();
    if (g_mailbox->cmd == CMD_QUIT) { g_quit = true; }
    barrier_wait(g_barrier, &g_local_sense);

    // After B2: cocotb proceeds to posedge eval.
    // DPI bridge always @(posedge clk) blocks fire during that eval.
    g_mailbox->cycle_count++;
}

} // extern "C"

// GCC/Clang constructor — runs before cocotb's VPI init
__attribute__((constructor))
static void pr_cocotb_init() {
    const char* shm_dir = std::getenv("PR_SHM_DIR");
    if (!shm_dir) {
        std::cerr << "PR_SHM_DIR not set — PR barrier disabled" << std::endl;
        return;
    }
    std::string dir(shm_dir);

    // Open mailbox
    g_mailbox = (ShmMailbox*)mmap_file((dir + "/cmd_mailbox.shm").c_str(), SHM_MAILBOX_SIZE);
    if (!g_mailbox) return;

    // Open barrier
    g_barrier = (ShmBarrier*)mmap_file((dir + "/barrier.shm").c_str(), 4096);
    if (!g_barrier) return;

    // Open partition channels
    for (int p = 0; p < NUM_PARTITIONS; p++) {
        std::string path = dir + "/partition_" + std::to_string(p) + ".shm";
        g_partition_bases[p] = mmap_file(path.c_str(), 0);
        if (!g_partition_bases[p]) return;
        g_partition_headers[p] = shm_header(g_partition_bases[p]);
    }

    // Init barrier sense
    g_local_sense = __atomic_load_n(&g_barrier->sense, __ATOMIC_ACQUIRE);

    // Signal ready
    g_mailbox->sim_status = SIM_STATUS_RUNNING;
    g_mailbox->cycle_count = 0;
}
