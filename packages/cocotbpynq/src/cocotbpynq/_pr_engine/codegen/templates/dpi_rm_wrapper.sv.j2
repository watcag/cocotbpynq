// RM-side DPI wrapper for {{ rm_design_name }}
// Partition: {{ part }}
// Generated by partial_reconfiguration DPI bridge generator

`timescale 1ns/1ps

module {{ wrapper_name }} (
{% set wrapper_ports = [] %}
{% for clk in clock_names %}
{% do wrapper_ports.append("    input wire " ~ clk) %}
{% endfor %}
{% if reset_name is not none %}
{% do wrapper_ports.append("    input wire " ~ reset_name) %}
{% endif %}
{{ wrapper_ports | join(",\n") }}
);

{% for port in to_rm %}
{% set nc = port.num_chunks %}
{% for c in range(nc) %}
{% set cw = chunk_width(port.width, c) %}
{% set dt = dpi_type(cw) %}
{% set suffix_d = "_chunk" ~ c ~ "_recv_data" if nc > 1 else "_recv_data" %}
{% set suffix_v = "_chunk" ~ c ~ "_recv_valid" if nc > 1 else "_recv_valid" %}
    import "DPI-C" function {{ dt }} dpi_rm_{{ part }}_{{ port.name }}{{ suffix_d }}();
    import "DPI-C" function int dpi_rm_{{ part }}_{{ port.name }}{{ suffix_v }}();
{% endfor %}
{% endfor %}
{% for port in from_rm %}
{% set nc = port.num_chunks %}
{% for c in range(nc) %}
{% set cw = chunk_width(port.width, c) %}
{% set dt = dpi_type(cw) %}
{% set suffix = "_chunk" ~ c ~ "_send" if nc > 1 else "_send" %}
    import "DPI-C" function void dpi_rm_{{ part }}_{{ port.name }}{{ suffix }}(input {{ dt }} data);
{% endfor %}
{% endfor %}

{% for port in to_rm %}
{% set width_str = "[" ~ (port.width - 1)|string ~ ":0]" if port.width > 1 else "" %}
    reg {{ width_str }} {{ port.name }} /* verilator public */;
{% endfor %}
{% for port in from_rm %}
{% set width_str = "[" ~ (port.width - 1)|string ~ ":0]" if port.width > 1 else "" %}
    wire {{ width_str }} {{ port.name }} /* verilator public */;
{% endfor %}

    // Instantiate the real RM: {{ rm_design_name }}
{% if parameters %}
    {{ rm_design_name }} #(
{% set param_list = [] %}
{% for pname, pval in parameters.items() %}
{% do param_list.append("        ." ~ pname ~ "(" ~ pval ~ ")") %}
{% endfor %}
{{ param_list | join(",\n") }}
    ) u_rm (
{% else %}
    {{ rm_design_name }} u_rm (
{% endif %}
{% set rm_conns = [] %}
{% for clk in clock_names %}
{% do rm_conns.append("        ." ~ clk ~ "(" ~ clk ~ ")") %}
{% endfor %}
{% if reset_name is not none %}
{% do rm_conns.append("        ." ~ reset_name ~ "(" ~ reset_name ~ ")") %}
{% endif %}
{% for port in to_rm %}
{% do rm_conns.append("        ." ~ port.name ~ "(" ~ port.name ~ ")") %}
{% endfor %}
{% for port in from_rm %}
{% do rm_conns.append("        ." ~ port.name ~ "(" ~ port.name ~ ")") %}
{% endfor %}
{{ rm_conns | join(",\n") }}
    );

{% for clk, ports in to_rm_by_clock.items() %}
    // Update inputs from DPI channels (clock: {{ clk }})
    always @(posedge {{ clk }}) begin
{% for port in ports %}
{% set nc = port.num_chunks %}
{% for c in range(nc) %}
{% set suffix_d = "_chunk" ~ c ~ "_recv_data" if nc > 1 else "_recv_data" %}
{% set suffix_v = "_chunk" ~ c ~ "_recv_valid" if nc > 1 else "_recv_valid" %}
{% set recv_fn = "dpi_rm_" ~ part ~ "_" ~ port.name ~ suffix_d ~ "()" %}
{% set result = sv_recv_trunc(port, recv_fn, c) %}
{% set valid_fn = "dpi_rm_" ~ part ~ "_" ~ port.name ~ suffix_v ~ "()" %}
{% if result is mapping or result is sequence and result is not string %}
        if ({{ valid_fn }})
            {{ result[0] }} <= {{ result[1] }};
{% else %}
        if ({{ valid_fn }})
            {{ port.name }} <= {{ result }};
{% endif %}
{% endfor %}
{% endfor %}
    end

{% endfor %}
{% for clk, ports in from_rm_by_clock.items() %}
    // Send outputs to static region via DPI channels (clock: {{ clk }})
    always @(posedge {{ clk }}) begin
{% for port in ports %}
{% set nc = port.num_chunks %}
{% for c in range(nc) %}
{% set suffix = "_chunk" ~ c ~ "_send" if nc > 1 else "_send" %}
        dpi_rm_{{ part }}_{{ port.name }}{{ suffix }}({{ sv_send_cast(port, c) }});
{% endfor %}
{% endfor %}
    end

{% endfor %}
endmodule
