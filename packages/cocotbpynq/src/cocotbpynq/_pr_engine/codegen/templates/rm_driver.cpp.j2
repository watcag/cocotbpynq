// RM driver for {{ variant_name }} (partition {{ part.name }})
// Generated by partial_reconfiguration

#include "dpi_shm_channel.h"
#include "barrier_sync.h"

#include <verilated.h>
{% if trace %}
{% if trace_type == 'fst' %}
#include <verilated_fst_c.h>
{% else %}
#include <verilated_vcd_c.h>
{% endif %}
{% endif %}
#include "{{ model_type }}.h"

#include <cstring>
#include <cstdlib>
#include <iostream>
#include <sys/mman.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <unistd.h>

// Required by Verilator
double sc_time_stamp() { return 0; }

// Exported for DPI functions in dpi_rm_*.cpp
void* g_channel_base = nullptr;
ShmPartitionHeader* g_channel_header = nullptr;

static void* mmap_file(const char* path, size_t expected_size, int* fd_out) {
    int fd = open(path, O_RDWR);
    if (fd < 0) { perror(path); return nullptr; }
    struct stat st;
    fstat(fd, &st);
    size_t sz = (expected_size > 0) ? expected_size : (size_t)st.st_size;
    void* ptr = mmap(nullptr, sz, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
    if (ptr == MAP_FAILED) { perror("mmap"); close(fd); return nullptr; }
    if (fd_out) *fd_out = fd; else close(fd);
    return ptr;
}

int main(int argc, char** argv) {
    const char* shm_dir = nullptr;
    int partition_index = -1;
    for (int i = 1; i < argc; i++) {
        if (std::string(argv[i]) == "--shm-dir" && i + 1 < argc)
            shm_dir = argv[++i];
        else if (std::string(argv[i]) == "--partition-index" && i + 1 < argc)
            partition_index = std::stoi(argv[++i]);
    }
    if (!shm_dir || partition_index < 0) {
        std::cerr << "Usage: rm_binary --shm-dir DIR --partition-index N" << std::endl;
        return 1;
    }

    std::string dir(shm_dir);

    // Open partition channel
    int ch_fd = -1;
    std::string ch_path = dir + "/partition_" + std::to_string(partition_index) + ".shm";
    g_channel_base = mmap_file(ch_path.c_str(), 0, &ch_fd);
    if (!g_channel_base) return 1;
    g_channel_header = shm_header(g_channel_base);
    struct stat ch_st; fstat(ch_fd, &ch_st);
    size_t ch_size = ch_st.st_size;

    // Open barrier
    int br_fd = -1;
    ShmBarrier* barrier = (ShmBarrier*)mmap_file((dir + "/barrier.shm").c_str(), 4096, &br_fd);
    if (!barrier) return 1;

    // Create RM model
    auto ctx = new VerilatedContext;
    auto model = new {{ model_type }}(ctx);

{% if trace %}
    // Trace setup — one VCD/FST per RM binary, timestamps tied to barrier cycles
    // so multiple RM traces can be merged/aligned with the static trace.
    ctx->traceEverOn(true);
{% if trace_type == 'fst' %}
    auto tfp = new VerilatedFstC;
{% else %}
    auto tfp = new VerilatedVcdC;
{% endif %}
    model->trace(tfp, 99);
    // Trace output path: prefer PR_TRACE_DIR env var, else fall back to shm_dir.
    // PID suffix disambiguates multiple reconfigures of the same partition
    // (each reconfigure spawns a new process → new trace segment).
    const char* trace_dir_env = getenv("PR_TRACE_DIR");
    std::string trace_dir = trace_dir_env ? std::string(trace_dir_env) : dir;
    std::string trace_path = trace_dir + "/rm_{{ variant_name }}_" +
                             std::to_string(getpid()) +
                             "{% if trace_type == 'fst' %}.fst{% else %}.vcd{% endif %}";
    tfp->open(trace_path.c_str());
    // Each simulated cycle uses 10 time units: negedge at +0, swap at +5, posedge at +10.
    uint64_t trace_time = 0;
{% endif %}

    // Init barrier sense from current global sense
    uint32_t local_sense = __atomic_load_n(&barrier->sense, __ATOMIC_ACQUIRE);

{% if part.reset_name is not none and part.reset_behavior != 'none_intel' %}
    // Assert reset for {{ part.reset_cycles }} cycles before signaling ready
    model->{{ part.reset_name }} = {{ assert_val }};
    for (int rst_cycle = 0; rst_cycle < {{ part.reset_cycles }}; rst_cycle++) {
{% for clk in part.clock_names %}
        model->{{ clk }} = 0;
{% endfor %}
        model->eval();
{% for clk in part.clock_names %}
        model->{{ clk }} = 1;
{% endfor %}
        model->eval();
    }
    model->{{ part.reset_name }} = {{ deassert_val }};
    model->eval();

{% endif %}
    // Signal ready to static binary
    shm_store32(&g_channel_header->rm_ready, 1);

    // Main simulation loop
    while (true) {
        // Check quit before barrier (allows clean exit during reconfig)
        if (shm_load32(&g_channel_header->quit)) {
            shm_store32(&g_channel_header->rm_ready, 0);  // signal we are exiting
            break;
        }

{% for clk in part.clock_names %}
        model->{{ clk }} = 0;
{% endfor %}
        model->eval();
{% if trace %}
        tfp->dump(trace_time);         // negedge
{% endif %}
        barrier_wait(barrier, &local_sense);  // 1: negedge done

        barrier_wait(barrier, &local_sense);  // 2: swap done
{% if trace %}
        tfp->dump(trace_time + 5);     // after swap
{% endif %}

{% for clk in part.clock_names %}
        model->{{ clk }} = 1;
{% endfor %}
        model->eval();
{% if trace %}
        tfp->dump(trace_time + 10);    // posedge
        tfp->flush();
        trace_time += 10;
{% endif %}
        barrier_wait(barrier, &local_sense);  // 3: posedge done
    }

    // Cleanup
{% if trace %}
    tfp->close();
    delete tfp;
{% endif %}
    delete model;
    delete ctx;
    munmap(g_channel_base, ch_size); close(ch_fd);
    munmap(barrier, 4096); close(br_fd);
    return 0;
}
