// RM shared library for {{ variant_name }} (partition {{ part.name }})
// Generated by partial_reconfiguration — dlopen variant.
//
// Exposes a C ABI so Python (ctypes) or a C++ host can:
//   1. dlopen this .dylib
//   2. call rm_init(shm_dir, partition_index)   — same setup as rm_binary's main()
//   3. (optionally) call rm_run(max_cycles)     — eval loop, exits when quit flag is set
//   4. call rm_destroy()                        — teardown
//   5. dlclose
//
// For benchmarking the swap mechanism (E7), only init+destroy are measured.
// For full sim, the host would call rm_run after init and rm_destroy after
// rm_run returns.

#include "dpi_shm_channel.h"
#include "barrier_sync.h"

#include <verilated.h>
#include "{{ model_type }}.h"

#include <cstring>
#include <cstdlib>
#include <cstdint>
#include <string>
#include <iostream>
#include <sys/mman.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <unistd.h>

// Required by Verilator (each loaded .dylib has its own copy)
double sc_time_stamp() { return 0; }

// Globals — per-.so, used by DPI bindings linked into this library.
void* g_channel_base = nullptr;
ShmPartitionHeader* g_channel_header = nullptr;

// Library-local state owned by rm_init/rm_destroy.
namespace {
    VerilatedContext* g_ctx = nullptr;
    {{ model_type }}* g_model = nullptr;
    ShmBarrier* g_barrier = nullptr;
    size_t g_channel_size = 0;
    int g_channel_fd = -1;
    int g_barrier_fd = -1;
    uint32_t g_local_sense = 0;
}

static void* mmap_file(const char* path, size_t expected_size, int* fd_out) {
    int fd = open(path, O_RDWR);
    if (fd < 0) { perror(path); return nullptr; }
    struct stat st;
    fstat(fd, &st);
    size_t sz = (expected_size > 0) ? expected_size : (size_t)st.st_size;
    void* ptr = mmap(nullptr, sz, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
    if (ptr == MAP_FAILED) { perror("mmap"); close(fd); return nullptr; }
    if (fd_out) *fd_out = fd; else close(fd);
    return ptr;
}

extern "C" {

const char* rm_variant_name() { return "{{ variant_name }}"; }

// Allocate channel + barrier mmap, build Verilator model, run reset.
// Returns 0 on success, non-zero on failure. Mirrors the main()'s setup
// in rm_driver.cpp.j2 up to the point rm_ready is set to 1.
int rm_init(const char* shm_dir, int partition_index) {
    if (!shm_dir || partition_index < 0) return 1;
    std::string dir(shm_dir);

    // Open partition channel
    std::string ch_path = dir + "/partition_" + std::to_string(partition_index) + ".shm";
    g_channel_base = mmap_file(ch_path.c_str(), 0, &g_channel_fd);
    if (!g_channel_base) return 1;
    g_channel_header = shm_header(g_channel_base);
    struct stat ch_st; fstat(g_channel_fd, &ch_st);
    g_channel_size = ch_st.st_size;

    // Open barrier
    g_barrier = (ShmBarrier*)mmap_file((dir + "/barrier.shm").c_str(), 4096, &g_barrier_fd);
    if (!g_barrier) return 1;

    // Create RM model
    g_ctx = new VerilatedContext;
    g_model = new {{ model_type }}(g_ctx);

    // Init barrier sense from current global sense
    g_local_sense = __atomic_load_n(&g_barrier->sense, __ATOMIC_ACQUIRE);

{% if part.reset_name is not none and part.reset_behavior != 'none_intel' %}
    // Assert reset for {{ part.reset_cycles }} cycles before signaling ready
    g_model->{{ part.reset_name }} = {{ assert_val }};
    for (int rst_cycle = 0; rst_cycle < {{ part.reset_cycles }}; rst_cycle++) {
{% for clk in part.clock_names %}
        g_model->{{ clk }} = 0;
{% endfor %}
        g_model->eval();
{% for clk in part.clock_names %}
        g_model->{{ clk }} = 1;
{% endfor %}
        g_model->eval();
    }
    g_model->{{ part.reset_name }} = {{ deassert_val }};
    g_model->eval();
{% endif %}

    // Signal ready
    shm_store32(&g_channel_header->rm_ready, 1);
    return 0;
}

// Drive one barrier cycle of simulation. Returns 1 if quit flag set, 0 otherwise.
int rm_step_one() {
    if (!g_model || !g_barrier || !g_channel_header) return 1;
    if (shm_load32(&g_channel_header->quit)) {
        shm_store32(&g_channel_header->rm_ready, 0);
        return 1;
    }
{% for clk in part.clock_names %}
    g_model->{{ clk }} = 0;
{% endfor %}
    g_model->eval();
    barrier_wait(g_barrier, &g_local_sense);  // 1: negedge done
    barrier_wait(g_barrier, &g_local_sense);  // 2: swap done
{% for clk in part.clock_names %}
    g_model->{{ clk }} = 1;
{% endfor %}
    g_model->eval();
    barrier_wait(g_barrier, &g_local_sense);  // 3: posedge done
    return 0;
}

// Run the main eval loop until quit is set. Equivalent to rm_binary's main loop.
void rm_run() {
    while (rm_step_one() == 0) { /* loop */ }
}

// Tear down — symmetric with rm_init.
void rm_destroy() {
    if (g_model) { delete g_model; g_model = nullptr; }
    if (g_ctx)   { delete g_ctx;   g_ctx = nullptr; }
    if (g_channel_base) { munmap(g_channel_base, g_channel_size); g_channel_base = nullptr; }
    if (g_channel_fd >= 0) { close(g_channel_fd); g_channel_fd = -1; }
    if (g_barrier) { munmap(g_barrier, 4096); g_barrier = nullptr; }
    if (g_barrier_fd >= 0) { close(g_barrier_fd); g_barrier_fd = -1; }
    g_channel_header = nullptr;
    g_channel_size = 0;
}

}  // extern "C"
