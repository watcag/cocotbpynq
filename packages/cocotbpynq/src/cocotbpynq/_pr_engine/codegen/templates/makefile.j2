# Generated Makefile for multi-binary DPI Verilator simulation
# Do not edit - regenerated by partial_reconfiguration

BUILD_DIR := {{ build_dir }}
DPI_DIR := {{ dpi_dir }}
STATIC_BINARY := $(BUILD_DIR)/static_binary

{% for rm in rm_binaries %}
RM_BINARY_{{ rm.name | upper }} := $(BUILD_DIR)/rm/{{ rm.name }}/rm_binary
RM_LIB_{{ rm.name | upper }} := $(BUILD_DIR)/rm/{{ rm.name }}/rm_lib{{ shlib_ext }}
{% endfor %}

VERILATOR ?= verilator
VERILATOR_ROOT ?= $(shell $(VERILATOR) --getenv VERILATOR_ROOT)

CXX ?= g++
CXXFLAGS := -std=c++17 -O2 -I$(VERILATOR_ROOT)/include -I$(VERILATOR_ROOT)/include/vltstd -I$(DPI_DIR){{ trace_cflags }}
{% if extra_cflags %}
CXXFLAGS += {{ extra_cflags }}
{% endif %}
LDFLAGS := -lpthread
{% if extra_ldflags %}
LDFLAGS += {{ extra_ldflags }}
{% endif %}

.PHONY: all clean

# ═══ Verilator library archives ═══

{% if not rm_only %}
# Static region: {{ static_module.name }}
{{ static_lib }}: {{ static_module.sources | join(' ') }}
	@mkdir -p {{ static_obj_dir }}
	$(VERILATOR) {{ verilator_common }} {{ static_obj_dir }} {{ verilator_trace }} --top-module {{ static_module.top_module }} --public-flat-rw -Wno-WIDTHTRUNC{{ static_vflags }} {{ static_include_str }} {{ static_module.sources | join(' ') }}
	$(MAKE) -C {{ static_obj_dir }} -f V{{ static_module.top_module }}.mk

{% endif %}
{% for rm in rm_binaries %}
{% set mod = rm.module %}
{% set rm_obj_dir = "$(BUILD_DIR)/" ~ mod.obj_dir_prefix ~ "obj_dir" %}
{% set rm_lib_path = rm_obj_dir ~ "/V" ~ mod.top_module ~ "__ALL.a" %}
# RM: {{ rm.name }}
{{ rm_lib_path }}: {{ mod.sources | join(' ') }}
	@mkdir -p {{ rm_obj_dir }}
	$(VERILATOR) {{ verilator_common }} {{ rm_obj_dir }} {{ verilator_trace }} --top-module {{ mod.top_module }}{% if mod.verilator_public %} --public-flat-rw{% endif %} -Wno-WIDTHTRUNC{% if mod.verilator_flags %} {{ mod.verilator_flags | join(' ') }}{% endif %} {% for d in mod.include_dirs %}-I{{ d }} {% endfor %}{{ mod.sources | join(' ') }}
	$(MAKE) -C {{ rm_obj_dir }} -f V{{ mod.top_module }}.mk

{% endfor %}
# ═══ Verilator support objects ═══

$(DPI_DIR)/verilated.o: $(VERILATOR_ROOT)/include/verilated.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

$(DPI_DIR)/verilated_threads.o: $(VERILATOR_ROOT)/include/verilated_threads.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

{% if trace %}
{% if trace_type == 'fst' %}
$(DPI_DIR)/verilated_fst_c.o: $(VERILATOR_ROOT)/include/verilated_fst_c.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<
{% else %}
$(DPI_DIR)/verilated_vcd_c.o: $(VERILATOR_ROOT)/include/verilated_vcd_c.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<
{% endif %}

{% endif %}
{% if not rm_only %}
# ═══ Static binary C++ objects ═══

{{ static_driver_obj }}: {{ static_driver_cpp }} {{ static_lib }}
	$(CXX) $(CXXFLAGS) -I{{ static_obj_dir }} -c -o $@ $<

{% for cpp_file in static_dpi_cpp_files %}
{% set obj_name = cpp_file | basename_stem ~ ".o" %}
$(DPI_DIR)/{{ obj_name }}: {{ cpp_file }} {{ static_lib }}
	$(CXX) $(CXXFLAGS) -I{{ static_obj_dir }} -c -o $@ $<

{% endfor %}
# ═══ Static binary ═══

$(STATIC_BINARY): {{ static_lib }} {{ static_all_objs | join(' ') }}
	$(CXX) $(CXXFLAGS) -o $@ {{ static_all_objs | join(' ') }} {{ static_lib }} $(LDFLAGS)

{% endif %}
# ═══ RM binaries ═══

{% for rm in rm_binaries %}
{% set mod = rm.module %}
{% set rm_obj_dir = "$(BUILD_DIR)/" ~ mod.obj_dir_prefix ~ "obj_dir" %}
{% set rm_lib = rm_obj_dir ~ "/V" ~ mod.top_module ~ "__ALL.a" %}
{% set rm_driver_obj = "$(BUILD_DIR)/rm/" ~ rm.name ~ "/rm_driver_" ~ rm.name ~ ".o" %}
{% set rm_dpi_obj = "$(BUILD_DIR)/rm/" ~ rm.name ~ "/dpi_rm_" ~ rm.partition_name ~ ".o" %}
{% set rm_lib_driver_obj = "$(BUILD_DIR)/rm/" ~ rm.name ~ "/rm_lib_" ~ rm.name ~ ".pic.o" %}
{% set rm_lib_dpi_obj = "$(BUILD_DIR)/rm/" ~ rm.name ~ "/dpi_rm_" ~ rm.partition_name ~ ".pic.o" %}
{% set rm_lib_verilator_lib = rm_obj_dir ~ "/libV" ~ mod.top_module ~ "_pic.a" %}
{{ rm_driver_obj }}: {{ rm.driver_cpp }} {{ rm_lib }}
	@mkdir -p $(BUILD_DIR)/rm/{{ rm.name }}
	$(CXX) $(CXXFLAGS) -I{{ rm_obj_dir }} -c -o $@ $<

{{ rm_dpi_obj }}: {{ rm.dpi_rm_cpp }} {{ rm_lib }}
	@mkdir -p $(BUILD_DIR)/rm/{{ rm.name }}
	$(CXX) $(CXXFLAGS) -I{{ rm_obj_dir }} -c -o $@ $<

$(RM_BINARY_{{ rm.name | upper }}): {{ rm_lib }} {{ rm_driver_obj }} {{ rm_dpi_obj }} {{ support_objs | join(' ') }}
	@mkdir -p $(BUILD_DIR)/rm/{{ rm.name }}
	$(CXX) $(CXXFLAGS) -o $@ {{ rm_driver_obj }} {{ rm_dpi_obj }} {{ support_objs | join(' ') }} {{ rm_lib }} $(LDFLAGS)

# ── dlopen variant: shared library form of the same RM ────────────────
# Rebuilds the dlopen-variant driver + DPI .cpp with -fPIC and re-links
# the Verilator-generated objects plus support objects into a single
# self-contained .dylib (or .so on Linux).
{{ rm_lib_driver_obj }}: $(DPI_DIR)/rm_lib_{{ rm.name }}.cpp {{ rm_lib }}
	@mkdir -p $(BUILD_DIR)/rm/{{ rm.name }}
	$(CXX) $(CXXFLAGS) -fPIC -I{{ rm_obj_dir }} -c -o $@ $<

{{ rm_lib_dpi_obj }}: {{ rm.dpi_rm_cpp }} {{ rm_lib }}
	@mkdir -p $(BUILD_DIR)/rm/{{ rm.name }}
	$(CXX) $(CXXFLAGS) -fPIC -I{{ rm_obj_dir }} -c -o $@ $<

$(RM_LIB_{{ rm.name | upper }}): {{ rm_lib }} {{ rm_lib_driver_obj }} {{ rm_lib_dpi_obj }} {{ support_objs | join(' ') }}
	@mkdir -p $(BUILD_DIR)/rm/{{ rm.name }}
	$(CXX) $(CXXFLAGS) -fPIC {{ shlib_ldflags }} -o $@ \
		{{ rm_lib_driver_obj }} {{ rm_lib_dpi_obj }} \
		{{ support_objs | join(' ') }} \
		{{ rm_lib }} $(LDFLAGS)

{% endfor %}
all: {{ all_binaries | join(' ') }}
{% if not rm_only %}
all_libs: {{ all_rm_libs | join(' ') }}
{% else %}
all_libs: {{ all_rm_libs | join(' ') }}
{% endif %}

clean:
{% if not rm_only %}
	rm -rf $(STATIC_BINARY) $(DPI_DIR)/*.o
	rm -rf {{ static_obj_dir }}
{% endif %}
	rm -rf $(BUILD_DIR)/rm
{% for rm in rm_binaries %}
	rm -rf $(BUILD_DIR)/{{ rm.module.obj_dir_prefix }}obj_dir
{% endfor %}
