// Static-side DPI bridge for partition: {{ part }}
// Replaces {{ module_name }} in static region
// Generated by partial_reconfiguration DPI bridge generator

`timescale 1ns/1ps

module {{ module_name }} (
{% set port_lines = [] %}
{% for clk in clock_names %}
{% do port_lines.append("    input wire " ~ clk) %}
{% endfor %}
{% if reset_name is not none %}
{% do port_lines.append("    input wire " ~ reset_name) %}
{% endif %}
{% for port in ports %}
{% set width_str = "[" ~ (port.width - 1)|string ~ ":0] " if port.width > 1 else "" %}
{% if port.direction == 'to_rm' %}
{% do port_lines.append("    input wire " ~ width_str ~ port.name) %}
{% else %}
{% do port_lines.append("    output reg " ~ width_str ~ port.name) %}
{% endif %}
{% endfor %}
{{ port_lines | join(",\n") }}
);

{% for port in to_rm %}
{% set nc = port.num_chunks %}
{% for c in range(nc) %}
{% set cw = chunk_width(port.width, c) %}
{% set dt = dpi_type(cw) %}
{% set suffix = "_chunk" ~ c ~ "_send" if nc > 1 else "_send" %}
    import "DPI-C" function void dpi_static_{{ part }}_{{ port.name }}{{ suffix }}(input {{ dt }} data);
{% endfor %}
{% endfor %}

{% for port in from_rm %}
{% set nc = port.num_chunks %}
{% for c in range(nc) %}
{% set cw = chunk_width(port.width, c) %}
{% set dt = dpi_type(cw) %}
{% set suffix_d = "_chunk" ~ c ~ "_recv_data" if nc > 1 else "_recv_data" %}
{% set suffix_v = "_chunk" ~ c ~ "_recv_valid" if nc > 1 else "_recv_valid" %}
    import "DPI-C" function {{ dt }} dpi_static_{{ part }}_{{ port.name }}{{ suffix_d }}();
    import "DPI-C" function int dpi_static_{{ part }}_{{ port.name }}{{ suffix_v }}();
{% endfor %}
{% endfor %}

{% for clk, ports in to_rm_by_clock.items() %}
    // Send inputs to RM via DPI channels (clock: {{ clk }})
    always @(posedge {{ clk }}) begin
{% for port in ports %}
{% set nc = port.num_chunks %}
{% for c in range(nc) %}
{% set suffix = "_chunk" ~ c ~ "_send" if nc > 1 else "_send" %}
        dpi_static_{{ part }}_{{ port.name }}{{ suffix }}({{ sv_send_cast(port, c) }});
{% endfor %}
{% endfor %}
    end

{% endfor %}
{% for clk, ports in from_rm_by_clock.items() %}
    // Receive outputs from RM via DPI channels (clock: {{ clk }})
    always @(posedge {{ clk }}) begin
{% for port in ports %}
{% set nc = port.num_chunks %}
{% for c in range(nc) %}
{% set suffix_d = "_chunk" ~ c ~ "_recv_data" if nc > 1 else "_recv_data" %}
{% set suffix_v = "_chunk" ~ c ~ "_recv_valid" if nc > 1 else "_recv_valid" %}
{% set recv_fn = "dpi_static_" ~ part ~ "_" ~ port.name ~ suffix_d ~ "()" %}
{% set result = sv_recv_trunc(port, recv_fn, c) %}
{% set valid_fn = "dpi_static_" ~ part ~ "_" ~ port.name ~ suffix_v ~ "()" %}
{% if result is mapping or result is sequence and result is not string %}
        if ({{ valid_fn }})
            {{ result[0] }} <= {{ result[1] }};
{% else %}
        if ({{ valid_fn }})
            {{ port.name }} <= {{ result }};
{% endif %}
{% endfor %}
{% endfor %}
    end

{% endfor %}
endmodule
